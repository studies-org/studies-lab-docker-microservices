# Copie para .env e troque as senhas (use só letras e números).
# O docker compose não sobe sem elas.

MYSQL_ROOT_PASSWORD=troque-root
ITEMS_DB_PASSWORD=troque-items
LOJAS_DB_PASSWORD=troque-lojas
PAGAMENTOS_DB_PASSWORD=troque-pagamentos
PEDIDOS_DB_PASSWORD=troque-pedidos

# Painel (UI + proxy /api/<serviço>/)
PAINEL_PORT=8000

# Portas dos serviços no host (só em 127.0.0.1)
ITEMS_PORT=8383
LOJAS_PORT=8282
PAGAMENTOS_PORT=8181
PEDIDOS_PORT=8080
